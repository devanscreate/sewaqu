---
import { BUNDLING_PACKAGES } from '../data/equipmentData';

const formatRupiah = (val: number) => {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    maximumFractionDigits: 0,
  }).format(val);
};
---

<section id="bundling" class="py-14 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
    <span class="inline-block px-3 py-1 rounded-full bg-campfire-light text-campfire font-bold text-xs uppercase tracking-wider mb-2">
      Rekomendasi Pemula & Rombongan
    </span>
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-pine-700 tracking-tight">
      Paket Bundling Siap Berangkat
    </h2>
    <p class="text-stone-muted text-sm sm:text-base mt-2">
      Hemat hingga 26% dibanding sewa eceran. Alat sudah disesuaikan agar pas dengan kapasitas dan kebutuhan di gunung.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
    {BUNDLING_PACKAGES.map((pkg) => (
      <div class="bg-white rounded-2xl border border-stone-border hover:border-pine-600 transition-all duration-200 shadow-sm hover:shadow-md flex flex-col overflow-hidden relative group">
        
        <!-- Header Card -->
        <div class="p-6 pb-4 border-b border-stone-border bg-stone-50/50">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-campfire text-white shadow-xs">
              {pkg.badge}
            </span>
            <span class="text-xs font-semibold text-stone-muted">
              {pkg.target}
            </span>
          </div>
          <h3 class="text-xl font-bold text-pine-700 leading-snug">
            {pkg.name}
          </h3>
          <p class="text-xs text-stone-muted mt-1 leading-relaxed">
            {pkg.description}
          </p>
        </div>

        <!-- Items Checklist -->
        <div class="p-6 flex-1 space-y-2.5">
          <p class="text-xs font-bold text-pine-700 uppercase tracking-wider mb-2">
            Kelengkapan Paket:
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-stone-dark">
            {pkg.items.map((item) => (
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-pine-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="leading-tight">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Pricing & Action CTA -->
        <div class="p-6 pt-4 bg-stone-bg/60 border-t border-stone-border">
          <div class="mb-4">
            <div class="flex items-baseline gap-2">
              <span class="text-2xl font-extrabold text-pine-700">
                {formatRupiah(pkg.pricePerNight)}
              </span>
              <span class="text-xs font-semibold text-stone-muted line-through">
                {formatRupiah(pkg.originalPricePerNight)}
              </span>
              <span class="text-xs font-medium text-stone-muted">/ malam</span>
            </div>
            <!-- Dynamic calculation display based on selected nights -->
            <div class="text-[11px] text-pine-600 font-medium mt-1">
              <span>Estimasi: </span>
              <span class="font-bold" x-text="$store.rental.formatRupiah({pkg.pricePerNight} * $store.rental.nights)">
                {formatRupiah(pkg.pricePerNight * 2)}
              </span>
              <span x-text="' (' + $store.rental.nights + ' malam)'"> (2 malam)</span>
            </div>
          </div>

          <button
            type="button"
            @click={`$store.rental.addItem({ id: '${pkg.id}', name: '${pkg.name}', pricePerNight: ${pkg.pricePerNight}, isBundle: true })`}
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-pine-700 hover:bg-pine-600 active:scale-[0.98] text-white font-bold text-sm shadow-sm transition-all"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
            <span>Tambah Paket Ini</span>
          </button>
        </div>

      </div>
    ))}
  </div>
</section>

