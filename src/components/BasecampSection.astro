---
import { BASECAMP_INFO } from '../data/equipmentData';
---

<section id="basecamp" class="py-14 sm:py-20 bg-stone-bg/80 border-t border-stone-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <span class="inline-block px-3 py-1 rounded-full bg-pine-100 text-pine-700 font-bold text-xs uppercase tracking-wider mb-2">
        Lokasi & Jam Ambil
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-pine-700 tracking-tight">
        Kunjungi Basecamp Kami
      </h2>
      <p class="text-stone-muted text-sm sm:text-base mt-2">
        Lokasi strategis di jalur utama pendakian, mudah diakses dengan parkir luas untuk mobil dan rombongan motor.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Basecamp Details Card -->
      <div class="lg:col-span-5 bg-white rounded-2xl border border-stone-border p-6 sm:p-8 flex flex-col justify-between shadow-xs">
        <div class="space-y-6">
          <div>
            <span class="text-xs font-bold text-campfire uppercase tracking-wider">Basecamp Resmi</span>
            <h3 class="text-xl sm:text-2xl font-bold text-pine-700 mt-1">
              {BASECAMP_INFO.name}
            </h3>
            <p class="text-xs text-stone-muted mt-1">
              {BASECAMP_INFO.tagline}
            </p>
          </div>

          <div class="space-y-4 text-xs sm:text-sm">
            <div class="flex items-start gap-3">
              <span class="text-xl">📍</span>
              <div>
                <strong class="block text-pine-700 font-bold">Alamat Lengkap:</strong>
                <p class="text-stone-muted mt-0.5 leading-relaxed">{BASECAMP_INFO.address}</p>
                <p class="text-[11px] text-pine-600 mt-1 font-semibold">{BASECAMP_INFO.landmarks}</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="text-xl">⏰</span>
              <div>
                <strong class="block text-pine-700 font-bold">Jam Buka Basecamp:</strong>
                <p class="text-stone-muted mt-0.5">{BASECAMP_INFO.hours}</p>
                <p class="text-[11px] text-stone-muted mt-0.5">Pengambilan malam di luar jam buka harap konfirmasi H-1 via WA.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="text-xl">📞</span>
              <div>
                <strong class="block text-pine-700 font-bold">Kontak & WhatsApp Admin:</strong>
                <p class="text-stone-muted mt-0.5">{BASECAMP_INFO.phoneDisplay}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-stone-border">
          <a
            href={`https://wa.me/${BASECAMP_INFO.whatsappNumber}?text=Halo%20Admin%20Puncak%20Raya%20Outdoor%2C%20saya%20mau%20tanya%20arah%20lokasi%20basecamp`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-lg bg-pine-700 hover:bg-pine-600 text-white font-bold text-sm shadow-sm transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.187-2.59-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.299.144.35.49 1.196.533 1.284.043.088.072.19.014.305-.058.115-.087.19-.174.289-.087.101-.184.225-.262.303-.09.088-.183.184-.079.362.105.178.468.772.998 1.246.687.614 1.266.804 1.444.892.179.088.283.074.388-.046.106-.118.455-.529.576-.71.121-.182.242-.152.404-.092.162.06 1.025.483 1.202.571.177.088.295.132.338.207.043.076.043.438-.101.843z" />
            </svg>
            <span>Hubungi Admin Basecamp</span>
          </a>
        </div>
      </div>

      <!-- Google Maps Embed Card -->
      <div class="lg:col-span-7 bg-white rounded-2xl border border-stone-border overflow-hidden min-h-[360px] shadow-xs relative">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15814.993952763327!2d110.4079815!3d-7.6993845!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a5e9581f4a9b5%3A0x6b4f7e2a4a7536a0!2sKaliurang%2C%20Hargobinangun%2C%20Pakem%2C%20Sleman%20Regency%2C%20Special%20Region%20of%20Yogyakarta!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid"
          width="100%"
          height="100%"
          style="border:0; min-height: 380px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
        ></iframe>
      </div>

    </div>
  </div>
</section>

