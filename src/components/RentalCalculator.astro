---
// RentalCalculator.astro
---

<!-- Floating Bottom Bar (Appears when items are in cart) -->
<div
  x-show="$store.rental.totalItemsCount > 0"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="transform translate-y-full opacity-0"
  x-transition:enter-end="transform translate-y-0 opacity-100"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="transform translate-y-0 opacity-100"
  x-transition:leave-end="transform translate-y-full opacity-0"
  class="fixed bottom-0 inset-x-0 z-50 p-3 sm:p-4 bg-white/95 backdrop-blur-md border-t border-stone-border shadow-2xl"
  style="display: none;"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-3 sm:gap-6">
    
    <!-- Summary Info -->
    <div class="flex items-center gap-3 sm:gap-5">
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-pine-700 text-white flex items-center justify-center font-bold text-lg sm:text-xl shadow-xs">
        🎒
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs sm:text-sm font-bold text-pine-700" x-text="$store.rental.totalItemsCount + ' Item Dipilih'">
            0 Item
          </span>
          <span class="text-stone-border">•</span>
          <span class="text-xs text-stone-muted font-semibold" x-text="$store.rental.nights + ' Malam Sewa'">
            1 Malam
          </span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-[11px] text-stone-muted">Total:</span>
          <span class="text-base sm:text-xl font-extrabold text-campfire" x-text="$store.rental.formatRupiah($store.rental.grandTotal)">
            Rp0
          </span>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        @click="$store.rental.isDrawerOpen = true"
        class="inline-flex items-center gap-2 bg-campfire hover:bg-campfire-hover active:scale-95 text-white px-4 sm:px-6 py-2.5 sm:py-3 rounded-xl font-bold text-xs sm:text-sm shadow-md transition-all"
      >
        <span>Lihat Rincian & Booking</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>

  </div>
</div>

<!-- Slide-over Drawer / Modal Checkout -->
<div
  x-show="$store.rental.isDrawerOpen"
  class="fixed inset-0 z-50 overflow-hidden"
  style="display: none;"
  aria-labelledby="slide-over-title"
  role="dialog"
  aria-modal="true"
>
  <!-- Backdrop -->
  <div
    x-show="$store.rental.isDrawerOpen"
    x-transition:enter="ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="$store.rental.isDrawerOpen = false"
    class="fixed inset-0 bg-stone-dark/60 backdrop-blur-xs transition-opacity"
  ></div>

  <div class="fixed inset-y-0 right-0 max-w-full flex pl-6 sm:pl-10">
    <div
      x-show="$store.rental.isDrawerOpen"
      x-transition:enter="transform transition ease-in-out duration-300 sm:duration-400"
      x-transition:enter-start="translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transform transition ease-in-out duration-300 sm:duration-400"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="translate-x-full"
      class="w-screen max-w-md bg-white shadow-2xl flex flex-col"
    >
      
      <!-- Drawer Header -->
      <div class="p-5 sm:p-6 bg-pine-700 text-white flex items-center justify-between">
        <div>
          <h3 class="text-lg font-extrabold" id="slide-over-title">
            Daftar Estimasi Sewa
          </h3>
          <p class="text-xs text-stone-200 mt-0.5">
            Rincian otomatis siap diteruskan ke WhatsApp Admin
          </p>
        </div>
        <button
          type="button"
          @click="$store.rental.isDrawerOpen = false"
          class="rounded-lg p-1.5 text-stone-200 hover:text-white hover:bg-pine-600 transition-colors"
          aria-label="Tutup"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Drawer Content Scrollable Area -->
      <div class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-6">
        
        <!-- Date Adjustment Card -->
        <div class="bg-stone-bg rounded-xl p-4 border border-stone-border space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-pine-700 uppercase tracking-wider">Jadwal Pendakian:</span>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-pine-700 text-white" x-text="$store.rental.nights + ' Malam'">
              2 Malam
            </span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <div>
              <label class="block text-stone-muted font-medium mb-1">Ambil:</label>
              <input
                type="date"
                x-model="$store.rental.startDate"
                class="w-full bg-white border border-stone-border rounded-lg px-2.5 py-1.5 font-semibold text-stone-dark text-xs focus:ring-1 focus:ring-campfire outline-none"
              />
            </div>
            <div>
              <label class="block text-stone-muted font-medium mb-1">Kembali:</label>
              <input
                type="date"
                x-model="$store.rental.endDate"
                class="w-full bg-white border border-stone-border rounded-lg px-2.5 py-1.5 font-semibold text-stone-dark text-xs focus:ring-1 focus:ring-campfire outline-none"
              />
            </div>
          </div>
        </div>

        <!-- Selected Items List -->
        <div>
          <div class="flex items-center justify-between mb-3">
            <h4 class="text-xs font-bold text-pine-700 uppercase tracking-wider">Alat Terpilih:</h4>
            <span class="text-xs text-stone-muted" x-text="$store.rental.totalItemsCount + ' unit'"></span>
          </div>

          <div x-show="$store.rental.cart.length === 0" class="text-center py-8 text-stone-muted text-xs">
            Belum ada alat yang dipilih. Silakan pilih dari katalog atau paket bundling.
          </div>

          <div class="space-y-3">
            <template x-for="item in $store.rental.cart" :key="item.id">
              <div class="bg-white rounded-xl border border-stone-border p-3 flex items-center justify-between gap-3 shadow-2xs">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span x-show="item.isBundle" class="text-[10px] bg-campfire text-white font-bold px-1.5 py-0.2 rounded">Paket</span>
                    <h5 class="text-xs font-bold text-pine-700 truncate" x-text="item.name"></h5>
                  </div>
                  <div class="text-[11px] text-stone-muted mt-0.5">
                    <span x-text="$store.rental.formatRupiah(item.pricePerNight)"></span> /mlm
                  </div>
                </div>

                <!-- Quantity Stepper & Remove -->
                <div class="flex items-center gap-2">
                  <div class="flex items-center bg-stone-bg rounded-lg border border-stone-border p-0.5">
                    <button
                      type="button"
                      @click="$store.rental.updateQuantity(item.id, -1)"
                      class="w-6 h-6 rounded bg-white text-pine-700 font-bold hover:bg-stone-200 flex items-center justify-center text-xs"
                    >
                      -
                    </button>
                    <span class="w-7 text-center text-xs font-bold text-pine-700" x-text="item.quantity"></span>
                    <button
                      type="button"
                      @click="$store.rental.updateQuantity(item.id, 1)"
                      class="w-6 h-6 rounded bg-pine-700 text-white font-bold hover:bg-pine-600 flex items-center justify-center text-xs"
                    >
                      +
                    </button>
                  </div>

                  <button
                    type="button"
                    @click="$store.rental.removeItem(item.id)"
                    class="text-stone-400 hover:text-red-500 p-1"
                    title="Hapus item"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </div>
            </template>
          </div>
        </div>

        <!-- Renter Information Form -->
        <div class="bg-stone-50 rounded-xl p-4 border border-stone-border space-y-3">
          <h4 class="text-xs font-bold text-pine-700 uppercase tracking-wider">Identitas Pemesan:</h4>
          <div>
            <label class="block text-[11px] text-stone-muted font-medium mb-1">Nama Lengkap (Sesuai KTP):</label>
            <input
              type="text"
              x-model="$store.rental.renterName"
              placeholder="Contoh: Budi Santoso"
              class="w-full bg-white border border-stone-border rounded-lg px-3 py-2 text-xs font-semibold text-stone-dark focus:ring-1 focus:ring-campfire outline-none"
            />
          </div>
          <div>
            <label class="block text-[11px] text-stone-muted font-medium mb-1">Nomor WhatsApp Aktif:</label>
            <input
              type="tel"
              x-model="$store.rental.renterPhone"
              placeholder="Contoh: 08123456789"
              class="w-full bg-white border border-stone-border rounded-lg px-3 py-2 text-xs font-semibold text-stone-dark focus:ring-1 focus:ring-campfire outline-none"
            />
          </div>
        </div>

        <!-- Guarantee Reminder Confirmation -->
        <div class="p-3 bg-campfire-light/60 border border-campfire/30 rounded-xl">
          <label class="flex items-start gap-2.5 cursor-pointer">
            <input
              type="checkbox"
              x-model="$store.rental.guaranteeConfirmed"
              checked
              class="mt-0.5 rounded text-campfire focus:ring-campfire"
            />
            <span class="text-[11px] text-stone-dark leading-snug">
              <strong>Paham Syarat Jaminan:</strong> Saya bersedia menitipkan <strong>1 KTP / SIM Asli</strong> saat pengambilan alat di basecamp.
            </span>
          </label>
        </div>

        <!-- Total Calculation Breakdown -->
        <div class="bg-stone-bg rounded-xl p-4 border border-stone-border space-y-2 text-xs">
          <div class="flex justify-between text-stone-muted">
            <span>Tarif Subtotal (per malam):</span>
            <span class="font-semibold text-stone-dark" x-text="$store.rental.formatRupiah($store.rental.dailySubtotal)"></span>
          </div>
          <div class="flex justify-between text-stone-muted">
            <span>Durasi Malam:</span>
            <span class="font-semibold text-stone-dark" x-text="$store.rental.nights + ' Malam'"></span>
          </div>
          <div class="pt-2 border-t border-stone-border flex justify-between items-baseline">
            <span class="font-bold text-pine-700 text-sm">Total Estimasi Sewa:</span>
            <span class="font-extrabold text-campfire text-lg" x-text="$store.rental.formatRupiah($store.rental.grandTotal)"></span>
          </div>
          <div class="flex justify-between text-[11px] text-stone-muted">
            <span>Estimasi DP 30% Kunci Jadwal:</span>
            <span class="font-semibold text-pine-600" x-text="$store.rental.formatRupiah($store.rental.downPayment)"></span>
          </div>
        </div>

      </div>

      <!-- Drawer Footer / WhatsApp Booking Button -->
      <div class="p-5 sm:p-6 bg-white border-t border-stone-border">
        <a
          :href="$store.rental.whatsappUrl"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-4 rounded-xl bg-campfire hover:bg-campfire-hover active:scale-[0.98] text-white font-extrabold text-sm shadow-md transition-all"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.187-2.59-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.299.144.35.49 1.196.533 1.284.043.088.072.19.014.305-.058.115-.087.19-.174.289-.087.101-.184.225-.262.303-.09.088-.183.184-.079.362.105.178.468.772.998 1.246.687.614 1.266.804 1.444.892.179.088.283.074.388-.046.106-.118.455-.529.576-.71.121-.182.242-.152.404-.092.162.06 1.025.483 1.202.571.177.088.295.132.338.207.043.076.043.438-.101.843z" />
          </svg>
          <span>Kirim Booking via WhatsApp</span>
        </a>
        <p class="text-[11px] text-center text-stone-muted mt-2">
          Format chat otomatis akan terisi lengkap dan diteruskan langsung ke admin.
        </p>
      </div>

    </div>
  </div>
</div>

