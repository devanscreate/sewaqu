---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Puncak Raya Outdoor - Rental Alat Pendakian & Camping Berkualitas',
  description = 'Sewa alat outdoor & pendakian gunung terawat, steril, dan lengkap. Hitung estimasi biaya sewa otomatis dan pesan langsung lewat WhatsApp.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏔️</text></svg>" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="bg-stone-bg text-stone-dark antialiased min-h-screen flex flex-col selection:bg-campfire selection:text-white">
    <slot />
  </body>
</html>

